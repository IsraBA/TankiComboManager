{
  "manifest_version": 3,
  "name": "Tanki Online — Combos & QoL",
  "version": "3.1",
  "description": "Quality-of-life tools for Tanki Online: save and switch full equipment combos in one click, and translate battle chat in real time.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.tankionline.com/*",
    "https://translate.googleapis.com/*",
    "https://lingva.lunar.icu/*",
    "https://lingva.ml/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.tankionline.com/*"
      ],
      "css": [
        "shared/components/drawer.css",
        "shared/components/switch.css",
        "shared/components/select.css",
        "features/combos/styles.css",
        "features/combos/combo_card.css",
        "features/combos/ui/lobby_button.css",
        "features/combos/ui/delete_combo_modal.css",
        "features/combos/ui/randomizer_settings.css",
        "features/combos/ui/import_export.css",
        "features/translator/main/gamesettings.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.tankionline.com/*"
      ],
      "js": [
        "features/translator/isolated/bridge.js",
        "features/translator/isolated/detect.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "*://*.tankionline.com/*"
      ],
      "js": [
        "features/combos/isolated/discover/parse.js",
        "features/combos/isolated/discover/state.js",
        "features/combos/isolated/discover/send.js",
        "features/combos/isolated/discover/actions.js",
        "features/combos/isolated/discover/index.js",
        "features/combos/isolated/detect.js",
        "features/combos/isolated/bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "*://*.tankionline.com/*"
      ],
      "js": [
        "features/combos/main/garage/names.js",
        "features/combos/main/garage/kotlin.js",
        "features/combos/main/garage/collect.js",
        "features/combos/main/garage/capture.js",
        "features/combos/main/garage/store.js",
        "features/combos/main/garage/mount.js",
        "features/combos/main/garage/protections.js",
        "features/combos/main/garage/devices.js",
        "features/combos/main/garage/device_catalog.js",
        "features/combos/main/garage/skins.js",
        "features/combos/main/garage/read.js",
        "features/combos/main/garage/apply.js",
        "features/combos/main/garage/bridge_main.js",
        "features/combos/main/garage/boot.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.tankionline.com/*"
      ],
      "js": [
        "shared/components/switch.js",
        "shared/components/select.js",
        "features/translator/main/settings.js",
        "features/translator/main/skiplist.js",
        "features/translator/main/translate.js",
        "features/translator/main/bidi.js",
        "features/translator/main/chat.js",
        "features/translator/main/gamesettings.js",
        "features/translator/main/toggle.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.tankionline.com/*"
      ],
      "js": [
        "shared/components/drawer.js",
        "shared/components/switch.js",
        "shared/components/select.js",
        "features/combos/lib/constants.js",
        "features/combos/lib/utils.js",
        "features/combos/lib/language_manager.js",
        "features/combos/core/combo_cleaner.js",
        "features/combos/core/migrator_match.js",
        "features/combos/core/combo_migrator.js",
        "features/combos/core/tab_navigator.js",
        "features/combos/core/scanners/base_item_scanner.js",
        "features/combos/core/scanners/augment_scanner.js",
        "features/combos/core/scanners/protection_scanner.js",
        "features/combos/core/combo_saver.js",
        "features/combos/core/instant_saver.js",
        "features/combos/core/equippers/base_item_equipper.js",
        "features/combos/core/equippers/augment_equipper.js",
        "features/combos/core/equippers/protection_equipper.js",
        "features/combos/core/combo_loader.js",
        "features/combos/core/instant_loader.js",
        "features/combos/core/navigation_helpers.js",
        "features/combos/core/auto_navigator.js",
        "features/combos/core/randomizer/item_list_scanner.js",
        "features/combos/core/randomizer/random_from_saved.js",
        "features/combos/core/randomizer/random_full.js",
        "features/combos/core/randomizer/randomizer.js",
        "features/combos/ui/menu_injector.js",
        "features/combos/ui/lobby_button_injector.js",
        "features/combos/ui/lobby_shortcut_handler.js",
        "features/combos/ui/combo_drag_handler.js",
        "features/combos/ui/delete_combo_modal.js",
        "features/combos/ui/randomizer_settings.js",
        "features/combos/ui/import_export.js",
        "features/combos/ui/combo_card_renderer.js",
        "features/combos/ui/card/rows.js",
        "features/combos/ui/card/events.js",
        "features/combos/ui/card/title_edit.js",
        "features/combos/ui/view_renderer.js",
        "features/combos/ui/view/template.js",
        "features/combos/ui/view/events.js",
        "features/combos/ui/view/scroll.js",
        "features/combos/ui/view/drag.js",
        "features/combos/ui/view/combo_list.js",
        "features/combos/ui/view/combo_actions.js",
        "features/combos/ui/view/delete_animation.js",
        "features/combos/ui/view/tank_preview.js",
        "features/combos/ui/view/hide_guard.js",
        "features/combos/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "features/translator/assets/flags/*.svg"
      ],
      "matches": [
        "*://*.tankionline.com/*"
      ]
    }
  ],
  "action": {
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
